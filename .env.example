# ─────────────────────────────────────────────────────────────
# Twitter / X  (OAuth 1.0a user context — REQUIRED for like + reply)
# Get these from the X Developer Portal for your app.
# NOTE: like + reply need user-context tokens, not just a bearer token.
# ─────────────────────────────────────────────────────────────
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Supabase
# Use the SERVICE ROLE key (server-side only — never expose client-side).
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Bot behavior
# ─────────────────────────────────────────────────────────────
# Comma-separated hashtags/keywords to search for.
SEARCH_TERMS=#ai,#nodejs

# How many tweets to reply to per run (default 1).
REPLIES_PER_RUN=1

# Dry run: when "true", the bot searches, filters with ChatGPT, and logs what
# it WOULD do (with reasoning) to Supabase, but does NOT like or reply.
# Set to "false" (or remove) to go live and actually post.
DRY_RUN=false

# How many tweets to pull from search per run (the candidate pool).
MAX_CANDIDATES=20

# Optional language filter (ISO code). Leave blank to disable.
SEARCH_LANG=en

# Exclude retweets from the search ("true"/"false").
EXCLUDE_RETWEETS=true

# Cron schedule for the internal scheduler (standard 5-field cron).
# Default: every hour on the hour. Examples:
#   "*/30 * * * *"  -> every 30 minutes
#   "0 */2 * * *"   -> every 2 hours
CRON_SCHEDULE=0 * * * *

# Timezone for the cron schedule (IANA name, e.g. America/New_York, UTC).
CRON_TIMEZONE=UTC

# Run a single pass immediately on startup, then continue on the cron
# schedule ("true"/"false"). Useful to verify config right after deploy.
RUN_ON_STARTUP=true
