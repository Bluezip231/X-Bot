# ─────────────────────────────────────────────────────────────
# SECRETS — copy this file to .env (locally) or set as Heroku config vars.
# This file holds ONLY secrets. Non-secret bot behavior (topics, news feeds,
# cron, dry-run, post limits, etc.) lives in runtime.config.js, committed to git.
# ─────────────────────────────────────────────────────────────

# Twitter / X  (OAuth 1.0a user context — REQUIRED for posting)
# Get these from the X Developer Portal. Posting needs user-context tokens
# (not just a bearer token), and the app must have Read+Write.
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# OpenAI
OPENAI_API_KEY=

# Supabase — use the SERVICE ROLE key (server-side only, never client-side).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional extra news source. Leave blank to use RSS feeds only.
# Free tier: https://www.thenewsapi.com  (100 req/day)
THENEWSAPI_KEY=

# Engagement dashboard login (HTTP basic auth). REQUIRED to view the dashboard —
# if either is blank, the dashboard route returns 503 (never accidentally public).
DASHBOARD_USER=
DASHBOARD_PASS=

# ─────────────────────────────────────────────────────────────
# Optional: any runtime.config.js value can be overridden here by name for
# local testing (an env var always wins). For example:
#   DRY_RUN=true
#   TOPICS=AI,cybersecurity,scams
#   MAX_TWEETS_PER_DAY=4
#   TWEETS_PER_RUN=1
#   CRON_SCHEDULE=0 * * * *
#   RUN_ON_STARTUP=false   # true = also post once on every dyno restart
#   EVERGREEN_RATIO=0.3   # share of runs that post tips/explainers vs news (0-1)
#   POST_STYLES=educational,warning,opinion,short viral,casual
#   DEBUG=true            # verbose per-feed / debug logging
# ─────────────────────────────────────────────────────────────
